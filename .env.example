# App configuration
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
# Required only when APP_ENV=prod
API_KEY=

# LLM configuration
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30
LLM_MAX_ATTEMPTS=3

# Embedding configuration
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434

# Office and data configuration
OFFICE_PHONE=02079460100
# DATA_DIR=/path/to/custom/data
CHROMA_DIR=.chroma
LEADS_FILE=leads/leads.jsonl
FAQ_TOP_K=3
FAQ_MAX_DISTANCE=0.6

# Runtime limits
MAX_TURNS=60
MAX_OFF_TOPIC=3
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_S=90
CORS_ORIGINS=[]

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lead_qualification_chatbot
